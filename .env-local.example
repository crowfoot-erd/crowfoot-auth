# crowfoot-auth 로컬 시크릿 템플릿 — 복사해서 .env-local로 만들고 값을 채운다 (gitignore됨)
# JWT HS256 서명 키 — Base64 인코딩된 32바이트(256bit) 이상. 생성:
#   openssl rand -base64 48
CROWFOOT_AUTH_JWT_SECRET=
# auth_flow 쿠키 HMAC-SHA256 서명 키 — JWT 키와 용도 분리. 생성:
#   openssl rand -base64 48
CROWFOOT_AUTH_FLOW_SECRET=
# GitHub OAuth 앱(로컬 개발 전용) — 02-auth/oauth-provider-setup.md
CROWFOOT_AUTH_GITHUB_CLIENT_ID=
CROWFOOT_AUTH_GITHUB_CLIENT_SECRET=
# Google OAuth 클라이언트 — PKCE(S256) 사용, 리디렉션 URI에 http://localhost:8080/auth/callback 등록
CROWFOOT_AUTH_GOOGLE_CLIENT_ID=
CROWFOOT_AUTH_GOOGLE_CLIENT_SECRET=
# Redis 블랙리스트 — 00-environment/redis-connection.md
CROWFOOT_REDIS_DATABASE=400
CROWFOOT_REDIS_PASSWORD=
