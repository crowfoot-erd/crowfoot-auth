# crowfoot-auth 운영(prod) 프로필 시크릿 템플릿 — 복사해서 .env-prod로 만들고 값을 채운다 (gitignore됨)
# 실제 운영 배포(k8s)에서는 이 파일 대신 Secret을 컨테이너 환경변수로 주입한다 (02-auth/requirements.md Section 1.4.3).
# 이 파일은 prod 프로필을 로컬에서 재현할 때만 쓴다 — local 개발 값(.env-local)과 혼용 금지.
# 키 생성: openssl rand -base64 48
CROWFOOT_AUTH_JWT_SECRET=
CROWFOOT_AUTH_FLOW_SECRET=
# 운영용 GitHub OAuth 앱 (02-auth/oauth-provider-setup.md Section 5 — 로컬 개발 앱과 별도)
CROWFOOT_AUTH_GITHUB_CLIENT_ID=
CROWFOOT_AUTH_GITHUB_CLIENT_SECRET=
CROWFOOT_REDIS_HOST=
CROWFOOT_REDIS_PORT=6379
CROWFOOT_REDIS_PASSWORD=
CROWFOOT_REDIS_DATABASE=400
